# Required: the Convex deployment URL (e.g. http://127.0.0.1:3210 or https://<tunnel>).
# Used by both the browser client (inlined at build time) and SSR.
NEXT_PUBLIC_CONVEX_URL=

# Optional: the S3 gateway port shown in the credentials/onboarding screens.
# Defaults to 3211. Set when the gateway is proxied through a different port.
NEXT_PUBLIC_S3_GATEWAY_PORT=3211

# Ollastack Email Provider
OLLASTACK_API_KEY=
# OLLASTACK_MAILBOX_ID=

# OpenPanel
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=

# Sentry
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
