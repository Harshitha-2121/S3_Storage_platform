# Convex deployment environment template (placeholders only — never commit real secrets).
# Set each with: bunx convex env set NAME value   (from packages/backend)
#
# --- External ("hybrid") backend: dashboard -> Convex action -> backend -> webhook ---
# Reachable FROM the backend container. On Docker Desktop use host.docker.internal;
# on a VM/LAN use the machine IP or DNS name. Must be http(s); trailing slash is stripped.
BACKEND_BASE_URL=http://host.docker.internal:4000
# Shared service key: must EXACTLY match the backend's SERVICE_KEY env.
BACKEND_SERVICE_KEY=change-me-32-hex-chars-min
# Shared webhook secret: must EXACTLY match the backend's WEBHOOK_SECRET env.
# The backend posts job results to <convex-site>/backend/webhook with x-webhook-secret.
BACKEND_WEBHOOK_SECRET=change-me-32-hex-chars-min
#
# --- Auth / site ---
# Built-in on self-hosted (do not set): CONVEX_SITE_URL
# Override only if the site origin is rewired (e.g. local OIDC-fix sidecar):
# OIDC_SITE_URL=http://127.0.0.1:3220
SITE_URL=http://localhost:3000
#
# --- Email (Resend) ---
RESEND_API_KEY=re_placeholder
RESEND_SENDER_EMAIL_AUTH=auth@example.com
#
# --- RustFS (server-side only; never exposed to browsers) ---
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
RUSTFS_REGION=us-east-1
#
# --- S3 gateway ---
S3_CREDENTIAL_ENCRYPTION_KEY=change-me-64-hex-chars
S3_MAX_OBJECT_BYTES=10737418240
S3_PRESIGN_TTL=300
#
# --- Dev only ---
# DEV_SEED=1  # enables seed/test-only internal functions; never set in production
