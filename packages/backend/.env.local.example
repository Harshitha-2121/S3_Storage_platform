# ---------------------------------------------------------------------------
# Local Convex connection — used by `npx convex dev` / `convex` CLI in this
# package. Copy to `.env.local` and fill in your values.
#
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# Self-hosted Convex API URL (the `backend` service in self-hosted/docker-compose.yml).
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210

# Admin key of the self-hosted deployment.
# Find it in the self-hosted dashboard (http://127.0.0.1:6791) or in the
# `convex-self-hosted` deployment configuration. Treat it like a password.
CONVEX_SELF_HOSTED_ADMIN_KEY=change-me

# Deployment URL the CLI pushes to.
CONVEX_URL=http://127.0.0.1:3210

# Public site origin, used by @convex-dev/auth for JWT verification and by the
# OIDC discovery flow (auth.config.ts). On self-hosted this points at the
# oidc-fix sidecar (:3220), because the upstream image serves invalid JWKS.
CONVEX_SITE_URL=http://127.0.0.1:3220
OIDC_SITE_URL=http://127.0.0.1:3220

# Origin of the Next.js dashboard (used to build auth redirect URLs).
SITE_URL=http://localhost:3000

# Optional: transactional email provider (Resend). When unset, OTP codes are
# only written to the Convex logs.
RESEND_API_KEY=
