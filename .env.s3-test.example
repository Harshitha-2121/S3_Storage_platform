# S3 gateway integration test configuration (PLACEHOLDERS ONLY - never commit real values).
# Copy this file to a private location, fill it in, export the variables, then run
# the integration tests. The real file is git-ignored via `.env.*`.

# Optional: defaults to http://127.0.0.1:3211/s3
S3_TEST_ENDPOINT=http://127.0.0.1:3211/s3

# Required: a disposable test credential with access to S3_TEST_BUCKET.
S3_TEST_ACCESS_KEY=<your-test-access-key>
S3_TEST_SECRET_KEY=<your-test-secret-key>

# Required: a bucket owned by the test credential.
S3_TEST_BUCKET=<your-test-bucket>

# Never point these tests at a production tenant. Rotate/revoke the credential
# immediately if it is ever committed or shared.
