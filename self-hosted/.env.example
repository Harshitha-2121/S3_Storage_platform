# ---------------------------------------------------------------------------
# Self-hosted Convex + RustFS stack — environment template
# Copy to `.env` (never commit the real file) and fill in the secrets.
#
#   cp .env.example .env
#
# All RustFS credentials below are server-side only. They are read by the
# RustFS container and by Convex (via `RUSTFS_ENDPOINT` / `RUSTFS_ACCESS_KEY` /
# `RUSTFS_SECRET_KEY` set with `npx convex env set`).
# ---------------------------------------------------------------------------

# --- Ports ---------------------------------------------------------------
# Convex API (functions + queries)  http://127.0.0.1:3210
PORT=3210
# Convex HTTP site origin (HTTP actions + JWKS/OIDC)
SITE_PROXY_PORT=3211
# Local OIDC-fix sidecar port (see oidc-fix-proxy.mjs)
OIDC_FIX_PORT=3220
# Convex dashboard  http://127.0.0.1:6791
DASHBOARD_PORT=6791

# --- Origins -------------------------------------------------------------
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
# Point the site origin at the OIDC-fix sidecar: the upstream backend image
# serves invalid JWKS/OIDC metadata on :3211, which breaks OIDC discovery.
CONVEX_SITE_ORIGIN=http://127.0.0.1:3220
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# --- Convex backend tuning ----------------------------------------------
DISABLE_BEACON=true
# Max wall-clock for a user-facing Convex action (seconds).
ACTIONS_USER_TIMEOUT_SECS=30
RUST_LOG=info
DOCUMENT_RETENTION_DELAY=172800

# --- RustFS (S3-compatible object storage) -------------------------------
# Server-side only. The same values must be set on the Convex deployment:
#   npx convex env set RUSTFS_ENDPOINT http://rustfs:9000
#   npx convex env set RUSTFS_ACCESS_KEY <value>
#   npx convex env set RUSTFS_SECRET_KEY <value>
#   npx convex env set RUSTFS_REGION us-east-1
#   npx convex env set RUSTFS_PUBLIC_ENDPOINT http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=HarshithaDev2026
RUSTFS_SECRET_KEY=LocalDevSecret-Change-This-9284
RUSTFS_REGION=us-east-1


# --- Optional Convex internals ------------------------------------------
# Only set these if you override the Convex backend defaults.
# INSTANCE_NAME=convex-self-hosted
# INSTANCE_SECRET=
# DATABASE_URL=
# MYSQL_URL=
# POSTGRES_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_FORCE_PATH_STYLE=true
# S3_ENDPOINT_URL=
# S3_STORAGE_FILES_BUCKET=
# S3_STORAGE_MODULES_BUCKET=
# S3_STORAGE_EXPORTS_BUCKET=
# S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=
# S3_STORAGE_SEARCH_BUCKET=
# APPLICATION_MAX_CONCURRENT_MUTATIONS=16
# APPLICATION_MAX_CONCURRENT_NODE_ACTIONS=16
# APPLICATION_MAX_CONCURRENT_QUERIES=16
# APPLICATION_MAX_CONCURRENT_V8_ACTIONS=16
# HTTP_SERVER_TIMEOUT_SECONDS=
# Redact function logs from HTTP clients. Backend logs (which contain
# auth codes in log-fallback mode) stay in the container log only.
# NOTE: auth codes appearing in container logs is inherent to the log
# fallback; set OLLASTACK (see packages/backend .env template) so codes
# are never logged.
REDACT_LOGS_TO_CLIENT=true
# RUST_BACKTRACE=1
