# ==============================================================================
# S3 Storage & Dashboard Application Environment Configuration
# ==============================================================================

# Core Application URL & Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Convex Backend Configuration
# ------------------------------------------------------------------------------
# For self-hosted Convex, point to the self-hosted Convex HTTP URL:
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
CONVEX_URL=http://127.0.0.1:3210
CONVEX_ADMIN_KEY=your_convex_admin_key_here

# ------------------------------------------------------------------------------
# Authentication & OIDC Configuration
# ------------------------------------------------------------------------------
# In self-hosted setups, SITE_URL points to the public client domain
SITE_URL=https://your-domain.trycloudflare.com
JWT_PRIVATE_KEY=your_rs256_pkcs8_private_key_pem_here
JWKS=your_jwks_json_string_here

# Email OTP Delivery (Resend / SMTP)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=auth@yourdomain.com

# ------------------------------------------------------------------------------
# External / Optional Integrations
# ------------------------------------------------------------------------------
# Ollastack API (Headless form/disposable inbox & webhook relay)
OLLASTACK_API_KEY=fmd_your_ollastack_api_key_here

# Telemetry & Monitoring (Optional)
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ------------------------------------------------------------------------------
# S3 Gateway & RustFS Storage Node
# ------------------------------------------------------------------------------
S3_GATEWAY_URL=http://127.0.0.1:3211/s3
RUSTFS_S3_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ROOT_USER=admin
RUSTFS_ROOT_PASSWORD=your_secure_rustfs_password
